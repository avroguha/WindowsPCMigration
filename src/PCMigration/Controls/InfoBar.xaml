<UserControl x:Class="PCMigration.Controls.InfoBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Self">
  <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource StrokeCard}" Padding="14,10" Margin="0,0,0,12">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,2,12,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrong}" Margin="0,0,0,2"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}"/>
        <ContentPresenter x:Name="Extra" Content="{Binding ExtraContent, ElementName=Self}" Margin="0,8,0,0"/>
      </StackPanel>
      <Button x:Name="ActionBtn" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="ActionBtn_Click"/>
    </Grid>
  </Border>
</UserControl>
