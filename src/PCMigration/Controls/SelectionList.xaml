<UserControl x:Class="PCMigration.Controls.SelectionList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration">
  <UserControl.Resources>
    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="success"><Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/></DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="warning"><Setter Property="Foreground" Value="{DynamicResource StatusCautionFg}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ItemsControl x:Name="Groups">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Style="{StaticResource Card}" Padding="16,12,16,10" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Title, StringFormat=group:{0}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource AccentText}"/><TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="15"/></StackPanel>
              </CheckBox>
              <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding Subtitle}" Margin="30,0,0,8"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <ItemsControl ItemsSource="{Binding Items}" Margin="30,0,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Grid.ColumnSpan="2" Margin="0,0,0,0"/>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" Margin="0,9,0,9" AutomationProperties.Name="{Binding Id}" ToolTipService.InitialShowDelay="600">
                      <CheckBox.ToolTip><TextBlock Text="{Binding Note}" MaxWidth="440" TextWrapping="Wrap"/></CheckBox.ToolTip>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </CheckBox>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}" Margin="16,11,0,0" MinWidth="64" TextAlignment="Right" VerticalAlignment="Top"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentPresenter Content="{Binding Footer}" Margin="30,8,0,0"/>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
