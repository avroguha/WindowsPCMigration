<local:AppPage x:Class="PCMigration.Pages.DonePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T1" Style="{StaticResource Title}" FontSize="32" Foreground="{DynamicResource StatusSuccessFg}"/><TextBlock x:Name="T1l" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T2" Style="{StaticResource Title}" FontSize="32"/><TextBlock x:Name="T2l" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18,14"><StackPanel><TextBlock x:Name="T3" Style="{StaticResource Title}" FontSize="32"/><TextBlock x:Name="T3l" Style="{StaticResource Caption}"/></StackPanel></Border>
    </Grid>
    <TextBlock x:Name="VersionLine" Style="{StaticResource Caption}" Margin="0,0,0,10" Visibility="Collapsed"/>
    <WrapPanel x:Name="Buttons" Margin="0,0,0,8">
      <Button x:Name="SignOutBtn" AutomationProperties.Name="Sign out now" Style="{StaticResource AccentButton}" Click="SignOut_Click" Margin="0,0,8,4" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource OnAccent}" Margin="0,0,8,0"/><TextBlock Text="Sign out now"/></StackPanel></Button>
      <Button x:Name="OpenFolderBtn" AutomationProperties.Name="Open the backup folder" Click="OpenFolder_Click" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open the backup folder"/></StackPanel></Button>
      <Button x:Name="ReportBtn" AutomationProperties.Name="Open the report" Click="Report_Click" Margin="0,0,8,4" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open the report"/></StackPanel></Button>
      <Button x:Name="ExtBtn" AutomationProperties.Name="Browser extensions list" Click="Ext_Click" Margin="0,0,8,4" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Browser extensions list"/></StackPanel></Button>
      <Button x:Name="InstallBtn" AutomationProperties.Name="Back to the install list" Click="Install_Click" Visibility="Collapsed" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Back to the install list"/></StackPanel></Button>
    </WrapPanel>
    <c:InfoBar x:Name="FailBar" Severity="Warning" Visibility="Collapsed"/>
    <c:InfoBar x:Name="LargeBar" Severity="Warning" Visibility="Collapsed"/>
    <c:InfoBar x:Name="WaitBar" Severity="Warning" Visibility="Collapsed"/>
    <c:InfoBar x:Name="ErrBar" Severity="Error" Visibility="Collapsed"/>
    <Border x:Name="NextCard" Style="{StaticResource Card}" Padding="20,16">
      <StackPanel>
        <TextBlock x:Name="NextTitle" Style="{StaticResource BodyStrong}" FontSize="15" Margin="0,0,0,8"/>
        <ItemsControl x:Name="NextSteps">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding N}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border x:Name="ManualCard" Style="{StaticResource Card}" Padding="20,16" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="Things only you can do" Style="{StaticResource BodyStrong}" FontSize="15"/>
        <TextBlock x:Name="ManualSub" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
        <ItemsControl x:Name="ManualSteps">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE73A;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiary}"/>
              <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</local:AppPage>
