<local:AppPage x:Class="PCMigration.Pages.InstallPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <local:AppPage.Resources>
    <DataTemplate x:Key="Row">
      <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
        <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="installed"><Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Column="1" Margin="0,9,12,9">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Body}"><Style.Triggers><DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="skipped"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Border Margin="8,0,0,0" Padding="6,1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Pill}"><Style.Triggers><DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="installed"><Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <TextBlock Text="{Binding StatusText}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PillText}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="installed"><Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
          </StackPanel>
          <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
          <Button Content="Open" Style="{StaticResource RowButton}" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" Click="Open_Click" Tag="{Binding}"/>
          <Button Content="Install now" Style="{StaticResource RowButton}" Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}" Click="InstallNow_Click" Tag="{Binding}"/>
          <Button Content="Copy name" Style="{StaticResource RowButton}" Visibility="{Binding CanCopy, Converter={StaticResource BoolToVis}}" Click="Copy_Click" Tag="{Binding}"/>
          <Button Content="Installed" Style="{StaticResource RowButton}" Click="Installed_Click" Tag="{Binding}"/>
          <Button Content="Skip" Style="{StaticResource RowButton}" Click="Skip_Click" Tag="{Binding}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DoneRow">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
        <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="installed"><Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Column="1" Margin="0,7,12,7">
          <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}"><Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
          <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Undo" Style="{StaticResource RowButton}" VerticalAlignment="Top" Margin="0,6,0,0" Click="Undo_Click" Tag="{Binding}"/>
      </Grid>
    </DataTemplate>
  </local:AppPage.Resources>
  <StackPanel>
    <c:InfoBar x:Name="LoadingBar" Severity="Informational" Title="Comparing this computer with the backup…" Message="Programs, Store apps, developer tools, VS Code and browser extensions, npm / pip / .NET / PowerShell packages. A few seconds."/>
    <c:InfoBar x:Name="ErrorBar" Severity="Error" ActionText="Try again" Visibility="Collapsed"/>
    <Grid x:Name="Tiles" Margin="0,0,0,8" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T1" Style="{StaticResource Title}" FontSize="32" Foreground="{DynamicResource StatusSuccessFg}"/><TextBlock Text="installed" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T2" Style="{StaticResource Title}" FontSize="32"/><TextBlock Text="still to do" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18,14"><StackPanel><TextBlock x:Name="T3" Style="{StaticResource Title}" FontSize="32" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="skipped" Style="{StaticResource Caption}"/></StackPanel></Border>
    </Grid>
    <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
      <Button Click="Recheck_Click" Margin="0,0,8,0" AutomationProperties.Name="Check again"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Check again"/></StackPanel></Button>
      <Button Content="Open the install list" Click="OpenList_Click" Margin="0,0,8,0"/>
      <Button Content="Copy the to-do list" Click="CopyTodo_Click"/>
    </StackPanel>
    <ItemsControl x:Name="Groups">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Padding="16,12,16,10">
            <StackPanel>
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="15"/>
                <TextBlock Grid.Column="1" Text="{Binding Progress}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </Grid>
              <Button Content="{Binding InstallAllText}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding CanInstallAll, Converter={StaticResource BoolToVis}}" Click="InstallAll_Click" Tag="{Binding}" ToolTip="Opens one PowerShell window that runs every install command in this group"/>
              <ItemsControl ItemsSource="{Binding Pending}" ItemTemplate="{StaticResource Row}"/>
              <Expander Header="{Binding DoneHeader}" Visibility="{Binding HasDone, Converter={StaticResource BoolToVis}}" IsExpanded="{Binding ExpandDone, Mode=OneWay}" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource DoneRow}"/>
              </Expander>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</local:AppPage>
