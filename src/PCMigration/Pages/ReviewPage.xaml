<local:AppPage x:Class="PCMigration.Pages.ReviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T1" Style="{StaticResource Title}" FontSize="32"/><TextBlock x:Name="T1l" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T2" Style="{StaticResource Title}" FontSize="32"/><TextBlock x:Name="T2l" Style="{StaticResource Caption}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="18,14"><StackPanel><TextBlock x:Name="T3" Style="{StaticResource Title}" FontSize="32"/><TextBlock x:Name="T3l" Style="{StaticResource Caption}"/></StackPanel></Border>
    </Grid>
    <c:InfoBar x:Name="OpenBar" Severity="Warning" ActionText="Close them for me" Visibility="Collapsed"/>
    <c:InfoBar x:Name="NetBar" Severity="Informational" Visibility="Collapsed"/>
    <Border Style="{StaticResource Card}" Padding="20,16">
      <StackPanel>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1"><TextBlock x:Name="WhereTitle" Style="{StaticResource BodyStrong}"/><TextBlock x:Name="WherePath" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,10"/>
        <ItemsControl x:Name="GroupRows">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left" Foreground="{DynamicResource AccentText}"/>
              <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}"/>
              <TextBlock Grid.Column="2" Text="{Binding Names}" Style="{StaticResource Caption}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="3" Text="{Binding Count}" Style="{StaticResource Caption}" TextAlignment="Right"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border x:Name="OptionsCard" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed">
      <StackPanel>
        <CheckBox x:Name="ForceCb" AutomationProperties.Name="restore-anyway" Checked="ForceCb_Changed" Unchecked="ForceCb_Changed">
          <StackPanel><TextBlock Text="Also restore settings whose program is not installed yet" Style="{StaticResource Body}"/><TextBlock Text="Normally those wait for the next run. Use this for programs that never appear in Apps and Features (portable tools), or when you simply want everything now." Style="{StaticResource Caption}"/></StackPanel>
        </CheckBox>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Note" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
  </StackPanel>
</local:AppPage>
