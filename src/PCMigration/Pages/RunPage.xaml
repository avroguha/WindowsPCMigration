<local:AppPage x:Class="PCMigration.Pages.RunPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <Border Style="{StaticResource Card}" Padding="24,20">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0"><TextBlock x:Name="Glyph" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="Status" Style="{StaticResource Subtitle}"/><TextBlock x:Name="Detail" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="Percent" Style="{StaticResource Title}" FontSize="32" TextAlignment="Right"/><TextBlock x:Name="Elapsed" Style="{StaticResource Caption}" TextAlignment="Right"/></StackPanel>
        </Grid>
        <ProgressBar x:Name="Bar" Maximum="100" Height="6" Margin="0,18,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Current" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ResumeBtn" AutomationProperties.Name="Resume now" Style="{StaticResource AccentButton}" Click="Resume_Click" Margin="0,0,8,0" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccent}" Margin="0,0,8,0"/><TextBlock Text="Resume now"/></StackPanel></Button>
            <Button x:Name="PauseBtn" AutomationProperties.Name="Pause" Click="Pause_Click" Margin="0,0,8,0" ToolTip="Finishes the item in hand, then stops. The rest can continue later - also after a restart."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="PauseText" Text="Pause"/></StackPanel></Button>
            <Button x:Name="CancelBtn" AutomationProperties.Name="Cancel" Click="Cancel_Click" ToolTip="Stops at once and removes what this run created."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Cancel"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <c:InfoBar x:Name="NetBar" Severity="Informational" Visibility="Collapsed"/>
    <c:InfoBar x:Name="ResultBar" Visibility="Collapsed"/>
    <Border Style="{StaticResource Card}" Padding="12,8">
      <Expander x:Name="LogExp" Header="Details">
        <StackPanel>
          <TextBox x:Name="Log" Style="{StaticResource LogBox}" Height="320"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
            <Button Content="Copy log" Click="Copy_Click" Margin="0,0,8,0"/>
            <Button Content="Open log file" Click="OpenLog_Click"/>
          </StackPanel>
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
</local:AppPage>
