<local:AppPage x:Class="PCMigration.Pages.ScanPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <Border x:Name="Progress" Style="{StaticResource Card}" Padding="20,16">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ProgressGlyph" Text="&#xE9F5;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}" Margin="0,0,14,0"/>
          <StackPanel Grid.Column="1"><TextBlock x:Name="ProgressTitle" Style="{StaticResource BodyStrong}" FontSize="16"/><TextBlock x:Name="ProgressSub" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
        </Grid>
        <ProgressBar x:Name="Bar" IsIndeterminate="True" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
    <c:InfoBar x:Name="ErrorBar" Severity="Error" Visibility="Collapsed" ActionText="Try again"/>
    <Grid x:Name="Tiles" Margin="0,4,0,8" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T1" Style="{StaticResource Title}" FontSize="32"/><TextBlock Text="settings found" Style="{StaticResource Caption}"/><TextBlock x:Name="T1s" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T2" Style="{StaticResource Title}" FontSize="32"/><TextBlock Text="pre-selected for you" Style="{StaticResource Caption}"/><TextBlock x:Name="T2s" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14"><StackPanel><TextBlock x:Name="T3" Style="{StaticResource Title}" FontSize="32"/><TextBlock Text="other data folders" Style="{StaticResource Caption}"/><TextBlock x:Name="T3s" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"/></StackPanel></Border>
      <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0" Padding="18,14"><StackPanel><TextBlock x:Name="T4" Style="{StaticResource Title}" FontSize="32"/><TextBlock Text="keys and passwords" Style="{StaticResource Caption}"/><TextBlock x:Name="T4s" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}"/></StackPanel></Border>
    </Grid>
    <c:InfoBar x:Name="OpenBar" Severity="Warning" Title="Save your work and close these programs first" ActionText="Close them for me" Visibility="Collapsed"/>
    <Border x:Name="GroupsCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="20,16">
      <StackPanel>
        <TextBlock Text="What was found, by group" Style="{StaticResource BodyStrong}" Margin="0,0,0,8"/>
        <ItemsControl x:Name="GroupRows">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left" Foreground="{DynamicResource AccentText}"/>
              <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}"/>
              <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Caption}"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="RescanBtn" Content="Scan again" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RescanBtn_Click"/>
      </StackPanel>
    </Border>
  </StackPanel>
</local:AppPage>
