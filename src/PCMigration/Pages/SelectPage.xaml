<local:AppPage x:Class="PCMigration.Pages.SelectPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Grid Width="280" Margin="0,0,8,0"><TextBox x:Name="Search" Padding="32,5,10,5" TextChanged="Search_TextChanged" AutomationProperties.Name="Search"/><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="Search settings" Style="{StaticResource BodySecondary}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
        <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
        <Button Content="Select none" Click="SelectNone_Click" Margin="0,0,8,0"/>
        <Button x:Name="AddFolderBtn" Click="AddFolder_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add a folder…"/></StackPanel></Button>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource AccentSoft}" Padding="12,5"><TextBlock x:Name="Totals" Style="{StaticResource PillText}" Foreground="{DynamicResource AccentText}"/></Border>
    </Grid>
    <c:InfoBar x:Name="OpenBar" Severity="Warning" Title="Save your work and close these programs first" ActionText="Close them for me" Visibility="Collapsed"/>
    <c:InfoBar x:Name="DiscoveryBar" Severity="Informational" Title="Still looking for other programs' data folders" Message="They appear at the bottom of this list when the scan finishes. You can go ahead without them." Visibility="Collapsed"/>
    <c:SelectionList x:Name="List"/>
  </StackPanel>
</local:AppPage>
