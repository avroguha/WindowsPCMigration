<local:AppPage x:Class="PCMigration.Pages.StartPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCMigration" xmlns:c="clr-namespace:PCMigration.Controls">
  <StackPanel>
    <c:InfoBar x:Name="RootBar" Severity="Error" Title="No place to keep the backup" Message="OneDrive was not found on this computer. Choose a folder that both computers can reach - a network share, for example." ActionText="Choose a folder" Visibility="Collapsed"/>
    <c:InfoBar x:Name="AdminBar" Severity="Informational" Title="Running as administrator" Visibility="Collapsed"/>
    <c:InfoBar x:Name="ResumeBar" Severity="Success" Title="Continue where you left off" ActionText="Continue" Visibility="Collapsed"/>
    <TextBlock Text="Which computer is this?" Style="{StaticResource Subtitle}" Margin="0,4,0,12"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <RadioButton x:Name="OldCard" Style="{StaticResource ChoiceCard}" GroupName="role" Margin="0,0,8,0" Checked="Role_Checked" AutomationProperties.Name="This is my old computer">
        <StackPanel>
          <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,12"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}"/></Border>
          <TextBlock Text="This is my old computer" Style="{StaticResource BodyStrong}" FontSize="16"/>
          <TextBlock Text="Pack my settings, my preferences and the list of programs I have, and put them in the backup location." Style="{StaticResource BodySecondary}" Margin="0,4,0,0"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NewCard" Grid.Column="1" Style="{StaticResource ChoiceCard}" GroupName="role" Margin="8,0,0,0" Checked="Role_Checked" AutomationProperties.Name="This is my new computer">
        <StackPanel>
          <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,12"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}"/></Border>
          <TextBlock Text="This is my new computer" Style="{StaticResource BodyStrong}" FontSize="16"/>
          <TextBlock Text="Show me what to install, then bring my settings here from the backup." Style="{StaticResource BodySecondary}" Margin="0,4,0,0"/>
        </StackPanel>
      </RadioButton>
    </Grid>
    <TextBlock x:Name="Guess" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
    <TextBlock Text="How it works" Style="{StaticResource Subtitle}" Margin="0,0,0,12"/>
    <Border Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="1" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Pack on the old computer" Style="{StaticResource BodyStrong}"/><TextBlock Text="Tick what to take and press Pack. Everything lands in the backup location." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,16,0"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="2" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Let it sync" Style="{StaticResource BodyStrong}"/><TextBlock Text="Wait for OneDrive to show the green tick on the PCMigration folder." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,16,0"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="3" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Install, then restore" Style="{StaticResource BodyStrong}"/><TextBlock Text="On the new computer, install the programs from the checklist, then press Restore." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="3"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="4" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Sign out and back in" Style="{StaticResource BodyStrong}"/><TextBlock Text="A short list tells you the few things only you can do - saved passwords, default apps." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </Border>
    <TextBlock Text="Run it as often as you like: a second pack merges into the same backup, a second restore only touches what you tick, and the install checklist remembers where you were." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
  </StackPanel>
</local:AppPage>
